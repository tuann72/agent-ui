{
  "name": "@tuann72/agent-ui",
  "version": "0.3.0",
  "description": "Scaffold Agent — a portable AI assistant for React — into your project. Copies the source into your repo; you own every file, no runtime dependency on agent-ui.",
  "keywords": [
    "ai",
    "assistant",
    "chat",
    "react",
    "scaffold",
    "ai-sdk",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuann72/agent-ui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/tuann72/agent-ui#readme",
  "bugs": "https://github.com/tuann72/agent-ui/issues",
  "type": "module",
  "bin": {
    "agent-ui": "bin/agent-ui.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "schema.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/bundle-templates.ts && bun build src/index.ts --outdir dist --target=node --format=esm",
    "prepack": "bun run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
